# Frontend environment variables
# Copy this file to .env.local and fill in your actual values.
#
# This app is built with Create React App, so only variables prefixed with
# REACT_APP_ are inlined into the bundle at build time. Anything else is
# ignored by the client build.

# Supabase project (Settings -> API in the Supabase dashboard)
REACT_APP_SUPABASE_URL=your_supabase_project_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Mapbox GL access token (account.mapbox.com)
REACT_APP_MAPBOX_TOKEN=your_mapbox_access_token_here

# OpenCage geocoding key, used by LocationSearch (opencagedata.com)
REACT_APP_OPENCAGE_API_KEY=your_opencage_api_key_here
